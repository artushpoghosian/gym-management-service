# Copy to .env and fill in JWT_SECRET. .env is gitignored; this file is not.
# Both services must get the same secret, or the workload service rejects the
# main service's tokens.

# Must be exactly 64 hex chars (parsed with HexFormat.parseHex). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

JWT_EXPIRATION_MS=3600000

# Hostname is the compose service name. For the plain `docker run` stack in
# DOCKER.md use tcp://gym-activemq:61616 instead.
ACTIVEMQ_BROKER_URL=tcp://activemq:61616
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
